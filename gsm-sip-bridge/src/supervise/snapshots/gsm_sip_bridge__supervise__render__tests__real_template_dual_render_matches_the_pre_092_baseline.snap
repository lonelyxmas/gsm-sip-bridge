---
source: gsm-sip-bridge/src/supervise/render.rs
expression: strip_comments(&rendered)
---
connections {
    ims0 {
        remote_addrs = 192.0.2.1

        vips = 0.0.0.0, ::

        local {
            auth = eap-aka
            id = 0001010000000001@nai.epc.mnc001.mcc001.3gppnetwork.org
        }
        remote {
            id = ims
        }
        children {
            ims0 {
                remote_ts = 0.0.0.0/0, ::/0
                updown = /etc/strongswan.d/ims-updown-0.sh

                esp_proposals = aes256gcm8-noesn, aes128-sha256-noesn, aes256-sha384-noesn, aes256-sha512-noesn, aes256-md5-noesn, aes128-sha1-noesn, aes256-sha1-noesn

                if_id_in = 23
                if_id_out = 23
            }
        }
        version = 2

        proposals = aes128-sha1-prfsha1-modp1024, aes128-sha1-prfsha1-modp2048, aes256-sha256-prfsha256-modp2048

        keyingtries = 0

        dpd_delay = 30s

        mobike = no
    }
}
